# .env.local にコピーして使う環境変数のテンプレート。
#
# ローカル開発時の値: `supabase start`（初回のみ）または `supabase status` の出力に含まれる
# API_URL / ANON_KEY をそのまま使う（デフォルトではポート番号までローカル固定値なので、
# 通常は下記の値をそのままコピーすれば動く）。
#
# クラウド Supabase に向ける場合（本番運用時。ユーザーが手動で行う）:
# Supabase ダッシュボード > Project Settings > API から
# Project URL / anon public key を取得し、下記の値を差し替える。
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key-from-supabase-start

# service_role キー（サーバー側専用）。`supabase status` の SERVICE_ROLE_KEY を使う。
# ブラウザに渡してはいけないため NEXT_PUBLIC_ を付けない（R2）。
# クラウド運用時は Project Settings > API > service_role secret の値に差し替える。
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key-from-supabase-status
